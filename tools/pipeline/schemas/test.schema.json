{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "test.json — 测试者产出",
  "type": "object",
  "required": ["round", "build", "suites", "verdict"],
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "build": {
      "type": "object",
      "required": ["rc"],
      "properties": {
        "rc": { "type": "integer" },
        "exe_size": { "type": "integer" },
        "tail": { "type": "string" }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rc", "result"],
        "properties": {
          "name": { "type": "string" },
          "rc": { "type": "integer" },
          "result": { "enum": ["pass", "fail", "blocked"] },
          "key_lines": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "targeted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "test", "result"],
        "properties": {
          "finding_id": { "type": "string" },
          "test": { "type": "string" },
          "rc": { "type": "integer" },
          "result": { "enum": ["pass", "fail", "blocked"] },
          "before_fix": { "type": "string" },
          "after_fix": { "type": "string" }
        }
      }
    },
    "db_roundtrip": { "type": "array", "items": { "type": "object" } },
    "regressions": { "type": "array", "items": { "type": "string" } },
    "blocked": { "type": "array", "items": { "type": "string" } },
    "verdict": { "enum": ["green", "red"] }
  }
}
