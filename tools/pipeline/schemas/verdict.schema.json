{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verdict.json — 裁判产出",
  "type": "object",
  "required": ["round", "score", "accept", "blocking", "regressions", "reason"],
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["weight", "score"],
        "properties": {
          "weight": { "type": "number" },
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "note": { "type": "string" }
        }
      }
    },
    "spot_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "what_i_did", "result"],
        "properties": {
          "target": { "type": "string" },
          "what_i_did": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "blocking": { "type": "array", "items": { "type": "string" } },
    "regressions": { "type": "array", "items": { "type": "string" } },
    "accept": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 8 },
    "next_focus": { "type": "string" }
  }
}
