{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "findings.json — 审查者产出",
  "type": "object",
  "required": ["round", "scope", "findings"],
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "file", "line", "title", "evidence", "impact", "confidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+-[0-9]+$" },
          "severity": { "enum": ["Critical", "Major", "Minor", "Info"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "symbol": { "type": "string" },
          "title": { "type": "string", "minLength": 8 },
          "evidence": { "type": "string", "minLength": 30 },
          "impact": { "type": "string", "minLength": 8 },
          "suggest": { "type": "string" },
          "confidence": { "enum": ["confirmed", "unverified"] },
          "affected": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "clean_areas": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
